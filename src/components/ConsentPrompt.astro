---
import type { AnalyticsConfig } from '../lib/types.ts';
import { resolveLocalized, type Localized } from '../lib/i18n.ts';

interface Props {
  config: AnalyticsConfig;
  locale?: string;
  /** 'corner' (default) docks bottom-right; 'bar' is a full-width bottom bar for
   * sites whose article column leaves no gutter wide enough for a corner card. */
  placement?: 'corner' | 'bar';
}

const DEFAULT_LABEL: Localized = {
  default: 'Analytics consent',
  es: 'Consentimiento de analítica',
  pt: 'Consentimento de análise',
};

const { prompt } = Astro.props.config;
const { locale, placement = 'corner' } = Astro.props;

// The UX constraints here are deliberate and not configurable: equal-weight
// buttons, decline first in DOM order, dismissal means deny, no overlay, no
// scroll lock. A consumer cannot turn this prompt into a dark pattern.
const label = resolveLocalized(prompt.label ?? DEFAULT_LABEL, locale);
const message = resolveLocalized(prompt.message, locale);
const accept = resolveLocalized(prompt.accept, locale);
const decline = resolveLocalized(prompt.decline, locale);
const learnMoreText = prompt.learnMore ? resolveLocalized(prompt.learnMore.text, locale) : null;
---

<div
  id="oia-prompt"
  data-placement={placement}
  role="dialog"
  aria-label={label}
  aria-live="polite"
  hidden
>
  <div class="oia-inner">
    <div class="oia-body">
      <svg
        class="oia-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="6" y1="20" x2="6" y2="12"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="18" y1="20" x2="18" y2="14"></line>
      </svg>
      <p class="oia-message">
        {message}{' '}
        {learnMoreText && prompt.learnMore && (
          <a href={prompt.learnMore.href} class="oia-learn-more">
            {learnMoreText}
          </a>
        )}
      </p>
    </div>
    <div class="oia-actions">
      <button type="button" data-oia-decline>{decline}</button>
      <button type="button" data-oia-accept>{accept}</button>
    </div>
  </div>
</div>

<script>
  import { bootConsentPrompt } from '../lib/client.ts';
  bootConsentPrompt();
  document.addEventListener('astro:page-load', bootConsentPrompt);
</script>

<style>
  /* Token values are R G B channel triplets (the @vdaluz/astro-blog contract),
     consumed as rgb(var(--name, fallback-triplet)). */
  #oia-prompt {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: 50;
    max-width: 24rem;
    padding: 1.25rem;
    border: 2px solid rgb(var(--accent, 124 124 255));
    border-radius: 0.875rem;
    background: rgb(var(--surface, 26 26 26));
    color: rgb(var(--fg, 238 238 238));
    box-shadow:
      0 12px 40px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.3);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      display 0.25s allow-discrete;
  }

  /* Entrance state: starts faded/offset, transitions to resting opacity:1/translateY(0). */
  #oia-prompt[hidden] {
    display: none;
    opacity: 0;
    transform: translateY(0.75rem);
  }

  @starting-style {
    #oia-prompt:not([hidden]) {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #oia-prompt {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    #oia-prompt {
      inset-inline: 0;
      inset-block-end: 0;
      max-width: none;
      width: 100%;
      border-radius: 0.75rem 0.75rem 0 0;
    }
  }

  /* 'bar' placement: a full-width bottom bar, scoped to >=641px so it never
     overrides the >=640px mobile sheet above (media queries add no
     specificity of their own - both rules are otherwise equally specific). */
  @media (min-width: 641px) {
    #oia-prompt[data-placement='bar'] {
      inset-inline: 0;
      inset-block-end: 0;
      max-width: none;
      width: 100%;
      padding: 0;
      border-inline: none;
      border-radius: 0;
    }

    #oia-prompt[data-placement='bar'] .oia-inner {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      max-width: 64rem;
      margin-inline: auto;
      padding: 1rem 1.5rem;
    }

    #oia-prompt[data-placement='bar'] .oia-body {
      flex: 1 1 auto;
      margin: 0;
    }

    #oia-prompt[data-placement='bar'] .oia-actions {
      flex: 0 0 auto;
    }

    #oia-prompt[data-placement='bar'] .oia-actions button {
      flex: 0 0 auto;
      min-width: 8rem;
    }
  }

  .oia-body {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin: 0 0 0.875rem;
  }

  .oia-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-block-start: 0.125rem;
    color: rgb(var(--accent, 124 124 255));
  }

  .oia-message {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* Underlined at rest, not hover-only - color alone doesn't distinguish a link from
     surrounding text (WCAG 1.4.1), and this package's whole pitch is anti-dark-pattern. */
  .oia-learn-more {
    color: rgb(var(--accent, 124 124 255));
    text-decoration: underline;
  }

  .oia-actions {
    display: flex;
    gap: 0.625rem;
  }

  /* One rule for both buttons: refusing must look exactly as easy as accepting. */
  .oia-actions button {
    flex: 1;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid rgb(var(--accent, 124 124 255));
    border-radius: 0.5rem;
    background: transparent;
    color: rgb(var(--fg, 238 238 238));
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .oia-actions button:hover,
  .oia-actions button:focus-visible {
    background: rgb(var(--accent, 124 124 255));
    color: rgb(var(--on-accent, 17 17 17));
  }
</style>
