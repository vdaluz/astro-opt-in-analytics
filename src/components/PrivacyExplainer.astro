---
import type { AnalyticsConfig } from '../lib/types.ts';
import { resolveLocalized, type Localized } from '../lib/i18n.ts';
import {
  resolvePrivacyExplainerStrings,
  type PrivacyExplainerStrings,
} from '../lib/privacy-explainer-strings.ts';

interface Props {
  config: AnalyticsConfig;
  locale?: string;
  /** Overrides any default copy, e.g. to add a 4th locale or correct a claim for a custom tracker. */
  strings?: Partial<PrivacyExplainerStrings>;
}

const { config, locale, strings: overrides } = Astro.props;

const trackers = Array.isArray(config.tracker) ? config.tracker : [config.tracker];
const documented = trackers.filter((tracker) => tracker.privacyInfo);

const t = (text: Localized) => resolveLocalized(text, locale);

const strings = resolvePrivacyExplainerStrings(overrides);
---

<div class="space-y-12">
  <div>
    <h2 class="text-2xl font-bold text-fg mb-4">{t(strings.whatsCollectedHeading)}</h2>
    <p class="text-muted mb-4">{t(strings.whatsCollectedBody)}</p>
    <ul class="list-disc list-inside text-muted space-y-2">
      {strings.bullets.map((bullet) => <li>{t(bullet)}</li>)}
    </ul>
  </div>

  <div>
    <h2 class="text-2xl font-bold text-fg mb-4">{t(strings.nothingLoadsHeading)}</h2>
    <p class="text-muted">
      {t(strings.nothingLoadsBodyBefore)}{' '}
      <a
        href="https://globalprivacycontrol.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline hover:text-accent-strong">{t(strings.gpcLinkText)}</a
      >{' '}
      {t(strings.nothingLoadsBodyAfter)}{' '}
      <button
        type="button"
        data-open-analytics-prompt
        class="text-accent underline hover:text-accent-strong"
      >
        {t(strings.reopenLinkText)}
      </button>
    </p>
  </div>

  {
    documented.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold text-fg mb-4">{t(strings.toolsHeading)}</h2>
        <p class="text-muted mb-4">{t(strings.toolsIntro)}</p>
        <ul class="space-y-4 text-muted">
          {documented.map((tracker) => (
            <li>
              <strong class="text-fg">{t(tracker.privacyInfo!.label)}</strong> (
              <a
                href={tracker.privacyInfo!.learnMoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent underline hover:text-accent-strong"
              >
                {tracker.privacyInfo!.toolName}
              </a>
              ){tracker.privacyInfo!.description && <> {t(tracker.privacyInfo!.description)}</>}
              {tracker.privacyInfo!.collects && tracker.privacyInfo!.collects.length > 0 && (
                <>
                  {' '}
                  {t(strings.alsoCollectsLabel)} {tracker.privacyInfo!.collects.map(t).join(', ')}.
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
